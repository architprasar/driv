# Public DEMO deployment: production security, simulated checkout, no real money.
# Copy to deployment/.env.production (never commit it) and replace every placeholder.
# Guide: deployment/DEPLOY.md

# Domain or subdomain whose DNS A record points at this server, without https://
PUBLIC_HOST=replace-with-your-domain
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DJANGO_SECRET_KEY=replace-with-an-independent-random-secret-at-least-50-characters

# Demo switches. Shows a site-wide "demo" banner, hides the site from search
# engines and only allows the simulated checkout (no provider keys needed).
DEMO_MODE=True
PAYMENTS_MODE=test

# No email provider yet: messages are printed to the backend/worker logs only.
# Password-reset and verification links will not reach users' inboxes.
# To add real email later, switch to django.core.mail.backends.smtp.EmailBackend
# and fill EMAIL_HOST / EMAIL_PORT / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=DrivioCars Demo <no-reply@example.com>
SUPPORT_EMAIL=support@example.com

# Optional in demo mode; shown on policy pages when set.
LEGAL_BUSINESS_NAME=
LEGAL_BUSINESS_ADDRESS=

MARKETPLACE_CURRENCY=INR
