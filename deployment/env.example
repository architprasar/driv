# Copy to deployment/.env.production and replace every placeholder.
PUBLIC_HOST=replace-with-your-public-domain
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DJANGO_SECRET_KEY=replace-with-an-independent-random-secret-at-least-50-characters
STRIPE_SECRET_KEY=replace-with-the-merchant-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-the-signed-webhook-secret
STRIPE_CONNECT_COUNTRY=IN
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=replace-with-your-smtp-host
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-your-smtp-user
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=replace-with-your-verified-sender
SUPPORT_EMAIL=replace-with-your-support-address
LEGAL_BUSINESS_NAME=replace-with-your-legal-business-name
LEGAL_BUSINESS_ADDRESS=replace-with-your-business-contact-address
MARKETPLACE_CURRENCY=INR
MARKETPLACE_TAX_RATE=0.08
MARKETPLACE_EXPRESS_FEE=25.00
RETURN_WINDOW_DAYS=7
